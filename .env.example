# ==============================================================================
# INFLUENCERS.COM PUBLIC MARKETPLACE PORTAL ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this template to .env or .env.local for local development.
# In production, configure environment variables in your deployment environment.

# Backend API v1 Base URL (mandatory; absolute URL required in production)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Creator Hub Portal URL (for creator login, registration, and onboarding handoff)
VITE_CREATOR_HUB_URL=http://localhost:8080

# Business / Brand Portal URL (for brand login, registration, and campaign management handoff)
VITE_BUSINESS_HUB_URL=http://localhost:8083

# Public Marketplace Site URL (canonical URLs, OpenGraph metadata)
VITE_SITE_URL=http://localhost:8082
